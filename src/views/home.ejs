<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles/main.css">
  <link rel="stylesheet" href="/styles/user_profile.css">
  <link rel="stylesheet" href="/styles/home.css">
  <script src="/scripts/lecturer_search.js" defer></script>
  <script src="/scripts/manage_consultations.js" defer></script>
  <script src="/scripts/peer_search.js" defer></script>
</head>
<body class="page page_home">
  <main class="card card_even_wider text_center">
    <% if (role === 'admin' && username) { %>
      <a href="/logs" class="logs_corner_link">View Logs</a>
    <% } %>
    <header>
      <h1><%= homeTitle %></h1>
      <% if (role) { %>
        <p>You are logged in as a <%= role %>.</p>
      <% } %>
    </header>

    <% if (flash && flash.success) { %>
      <div class="success"><%= flash.success %></div>
    <% } %>

    <% if (flash && flash.error) { %>
      <div class="error"><%= flash.error %></div>
    <% } %>

    <% if ((role === 'student' || role === 'admin') && username) { %>
      <section class="home_navigation">
        <div class="home_navigation_actions">
          <a class="home_navigation_primary" href="/user_profile?user=<%= encodeURIComponent(username) %>">User Profile</a>
          <a href="/consultations/new">Create Consultation</a>
          <a href="/join_consultation">Join Consultation</a>
          <button type="button" id="manage_consultations_btn" class="home_navigation_primary">Manage Consultations</button>
        </div>
      </section>

    <% } else if (role === 'lecturer' && username) { %>
      <section class="home_navigation">
        <div class="home_navigation_actions">
          <a class="home_navigation_primary" href="/user_profile?user=<%= encodeURIComponent(username) %>">User Profile</a>
          <a href="/scheduled_consultations">Scheduled Consultations</a>
          <a href="/daily_summary">Daily<br>Summary</a>
          <button type="button" id="manage_consultations_btn" class="home_navigation_primary">Manage Consultations</button>
        </div>
      </section>
    <% } else if (username) { %>
      <a class="back_link" href="/user_profile?user=<%= encodeURIComponent(username) %>">User Profile</a>
    <% } %>

    <% if ((role === 'student' || role === 'admin' || role === 'lecturer') && username) { %>
      <dialog id="manage_consultations_dialog" class="manage_dialog">
        <div class="manage_dialog_header">
          <h2 class="manage_dialog_title">My Consultations</h2>
          <button type="button" id="close_manage_dialog" class="manage_dialog_close">Close</button>
        </div>
        <p id="manage_consultations_msg" class="is_hidden" aria-live="polite"></p>
        <div id="manage_consultations_list"></div>
      </dialog>
    <% } %>

    <% if (role === 'student') { %>
      <section class="followed_dashboard_section">
        <h2 class="home_navigation_title">Following</h2>
        <p class="home_navigation_text">Quick access to lecturers you follow and their upcoming consultations.</p>

        <% if (followedLecturers.length === 0) { %>
          <div class="profile_detail followed_dashboard_empty">
            <p class="profile_detail_value">Follow lecturers from the search results below to pin them here.</p>
          </div>
        <% } else { %>
          <div class="profile_details followed_dashboard_grid">
            <% followedLecturers.forEach(function (lecturer) { %>
              <% const lecturerName = `${lecturer.firstName || ''} ${lecturer.lastName || ''}`.trim() || lecturer.username %>
              <% const institutionText = [lecturer.facultyId, lecturer.schoolId].filter(Boolean).join(', ') %>
              <article class="profile_detail">
                <h3 class="profile_detail_label"><%= lecturerName %></h3>
                <p class="profile_detail_value"><%= institutionText || 'Lecturer' %></p>
                <div class="followed_dashboard_actions">
                  <a class="button_compact" href="/user_profile?user=<%= encodeURIComponent(lecturer.username) %>">View Schedule</a>
                  <a class="button_compact" href="/join_consultation?lecturerId=<%= encodeURIComponent(lecturer.username) %>">View Consultations</a>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>

        <h2 class="home_navigation_title followed_dashboard_subtitle">Upcoming from followed lecturers</h2>

        <% if (followedConsultations.length === 0) { %>
          <div class="profile_detail followed_dashboard_empty">
            <p class="profile_detail_value">No upcoming consultations from followed lecturers.</p>
          </div>
        <% } else { %>
          <section class="dashboard_consultations">
            <% followedConsultations.forEach(function (consultation) { %>
              <% const statusLabel = consultation.hasJoined ? 'Joined' : consultation.isFull ? 'Fully Booked' : 'Open' %>
              <article class="dashboard_consultation_card">
                <h3><%= consultation.name %></h3>
                <p class="dashboard_consultation_meta"><strong>Lecturer:</strong> <%= consultation.lecturer %></p>
                <p class="dashboard_consultation_meta"><strong>Date:</strong> <%= consultation.date %></p>
                <p class="dashboard_consultation_meta"><strong>Time:</strong> <%= consultation.time %></p>
                <p class="dashboard_consultation_meta"><strong>Status:</strong> <%= statusLabel %></p>
                <div class="followed_dashboard_actions">
                  <a class="button_compact" href="/join_consultation?lecturerId=<%= encodeURIComponent(consultation.lecturerId) %>&date=<%= encodeURIComponent(consultation.date) %>&time=<%= encodeURIComponent(consultation.startTime) %>">Open Consultation</a>
                </div>
              </article>
            <% }) %>
          </section>
        <% } %>
      </section>
    <% } %>

    <section class="calendar_section">
      <h2 class="calendar_title"><%= calendar.monthLabel %></h2>
      <table class="calendar_table">
        <thead>
          <tr>
            <% calendar.dayLabels.forEach((dayLabel) => { %>
              <th class="calendar_heading" scope="col"><%= dayLabel %></th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% calendar.weeks.forEach(function (week) { %>
            <tr>
              <% week.forEach(function (day) { %>
                <% if (day.isEmpty) { %>
                  <td class="calendar_day calendar_day_empty"></td>
                <% } else if (role === 'student' || role === 'admin') { %>
                  <% const dayCons = consultationsByDate[day.isoDate] || [] %>
                  <td class="calendar_day">
                    <div class="calendar_day_content">
                      <span class="calendar_day_number"><%= day.dayNumber %></span>
                      <% dayCons.forEach(function (con) { %>
                        <% const statusLabel = con.hasJoined ? 'Joined' : con.isFull ? 'Fully Booked' : 'Unjoined' %>
                        <span class="calendar_day_note <%= con.hasJoined ? 'calendar_day_note_joined' : con.isFull ? 'calendar_day_note_full' : 'calendar_day_note_unjoined' %>"><%= con.name %> &middot; <%= con.lecturer %> &middot; <%= con.time %> &middot; <%= statusLabel %></span>
                      <% }) %>
                    </div>
                  </td>
                <% } else { %>
                  <td class="calendar_day<%= day.availabilityState === 'available' ? ' calendar_day_available' : '' %><%= day.availabilityState === 'unavailable' ? ' calendar_day_unavailable' : '' %>">
                    <div class="calendar_day_content">
                      <span class="calendar_day_number"><%= day.dayNumber %></span>
                      <% if (day.availabilityText) { %>
                        <span class="calendar_day_note"><%= day.availabilityText %></span>
                      <% } %>
                    </div>
                  </td>
                <% } %>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>

    <% if (role === 'student' || role === 'admin') { %>
      <div class="search_reveal_row">
        <button type="button" id="lecturer_search_btn">Search Lecturer</button>
        <button type="button" id="peer_search_btn">Find a Wits Peer</button>
      </div>
      <section id="peer_search_section" class="peer_search_section<%= hasPeerSearch ? '' : ' is_hidden' %>">
        <h2 class="home_navigation_title">Find a Wits Peer</h2>
        <p class="home_navigation_text">Search for other Wits users by name, degree, or course.</p>

        <form action="/home" method="get">
          <div class="search_criteria peer_search_criteria">
            <label class="search_filter">
              Degree
              <input type="text" name="peerDegree" value="<%= peerDegree %>" placeholder="e.g. BSc (Eng) - Electrical Engineering">
            </label>

            <label class="search_filter">
              Course
              <input type="text" name="peerCourse" value="<%= peerCourse %>" placeholder="e.g. ELEN">
            </label>
          </div>

          <div class="search_flex peer_search_flex">
            <label class="search_box">
              Search
              <input type="text" name="peerQuery" value="<%= peerQuery %>" placeholder="Name and/or username">
            </label>

            <button type="submit" class="search_button">Search Peers</button>
          </div>
        </form>

        <section class="results">
          <% if (!hasPeerSearch) { %>
            <p>Search by name, degree, or course to find other Wits users.</p>
          <% } else if (peers.length === 0) { %>
            <p>No peers found.</p>
          <% } else { %>
            <% peers.forEach(function (peer) { %>
              <% const peerName = `${peer.firstName || ''} ${peer.lastName || ''}`.trim() || peer.username %>
              <% const peerInstitution = [peer.facultyId, peer.schoolId].filter(Boolean).join(', ') %>
              <% const peerCourses = Array.isArray(peer.coursePreview) ? peer.coursePreview : [] %>
              <article class="lecturer_result_card peer_result_card">
                <div class="peer_result_summary">
                  <a class="lecturer_result_link" href="/user_profile?user=<%= encodeURIComponent(peer.username) %>">
                    <%= peerName %>
                  </a>
                  <p class="peer_result_meta"><strong>Username:</strong> <%= peer.username %></p>
                  <p class="peer_result_meta"><strong>Degree:</strong> <%= peer.degree || 'Not shared yet' %></p>
                  <% if (peerInstitution) { %>
                    <p class="peer_result_meta"><strong>School:</strong> <%= peerInstitution %></p>
                  <% } %>
                  <% if (peerCourses.length > 0) { %>
                    <p class="peer_result_meta"><strong>Courses:</strong> <%= peerCourses.join(', ') %><%= Array.isArray(peer.courses) && peer.courses.length > peerCourses.length ? ' ...' : '' %></p>
                  <% } %>
                </div>
                <a class="button_compact" href="/user_profile?user=<%= encodeURIComponent(peer.username) %>">View Profile</a>
              </article>
            <% }) %>
          <% } %>
        </section>
      </section>
    <% } %>

    <% if (role === 'student' || role === 'admin') { %>
      <section id="lecturer_search_section" class="<%= (query || facultyId || schoolId) ? '' : 'is_hidden' %>">
      <h2 class="home_navigation_title">Find a Lecturer</h2>
      <section>
        <form id="lecturer_search_form" action="/home" method="get">
          <div class="search_criteria">
            <label class="search_filter">
              Faculty
              <select name="facultyId">
                <option value="">All faculties</option>
                <% faculties.forEach(function (faculty) { %>
                  <option value="<%= faculty %>" <%= facultyId === faculty ? 'selected' : '' %>>
                    <%= faculty %>
                  </option>
                <% }) %>
              </select>
            </label>

            <label class="search_filter">
              School
              <select name="schoolId">
                <option value="">All schools</option>
                <% schools.forEach(function (school) { %>
                  <option value="<%= school %>" <%= schoolId === school ? 'selected' : '' %>>
                    <%= school %>
                  </option>
                <% }) %>
              </select>
            </label>
          </div>

          <div class="search_flex">
            <label class="search_box">
              Search
              <input type="text" name="q" value="<%= query %>" placeholder="Name and/or username">
            </label>

            <button type="submit" class="search_button">Search</button>
          </div>
        </form>
      </section>

      <section id="lecturer_results" class="results" data-can-follow="<%= role === 'student' ? 'true' : 'false' %>">
        <% if (lecturers.length === 0) { %>
          <p>No lecturers found.</p>
        <% } else { %>
          <% lecturers.forEach(function (lecturer) { %>
            <article class="lecturer_result_card">
              <a class="lecturer_result_link" href="/user_profile?user=<%= encodeURIComponent(lecturer.username) %>">
                <%= lecturer.firstName %> <%= lecturer.lastName %> &mdash; <%= lecturer.facultyId %>, <%= lecturer.schoolId %>
              </a>

              <% if (role === 'student') { %>
                <% if (lecturer.isFollowed) { %>
                  <span class="lecturer_result_following">Following</span>
                <% } else { %>
                  <form class="lecturer_result_follow_form" action="/users/<%= encodeURIComponent(lecturer.username) %>/follow" method="post">
                    <button type="submit">Follow</button>
                  </form>
                <% } %>
              <% } %>
            </article>
          <% }) %>

          <% if (totalPages > 1) { %>
            <%
              const _vis = new Set([1, 2, 3, totalPages - 2, totalPages - 1, totalPages])
              for (let _i = page - 2; _i <= page + 2; _i++) { if (_i >= 1 && _i <= totalPages) _vis.add(_i) }
              const _pages = [..._vis].sort((a, b) => a - b)
            %>
            <nav class="pagination">
              <% _pages.forEach(function (_p, _idx) { %>
                <% if (_idx > 0 && _p - _pages[_idx - 1] > 1) { %>
                  <span class="pagination_ellipsis">...</span>
                <% } %>
                <a
                  href="/home?q=<%= encodeURIComponent(query) %>&facultyId=<%= encodeURIComponent(facultyId) %>&schoolId=<%= encodeURIComponent(schoolId) %>&page=<%= _p %>"
                  class="pagination_link<%= _p === page ? ' pagination_link_active' : '' %>"
                ><%= _p %></a>
              <% }) %>
            </nav>
          <% } %>
        <% } %>
      </section>
      </section>
    <% } %>
  </main>
</body>
</html>
