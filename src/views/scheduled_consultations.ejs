<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles/main.css">
  <link rel="stylesheet" href="/styles/join_consultation.css">
  <script src="/scripts/scheduled_consultations.js" defer></script>
</head>
<body class="page page_home">
  <main class="card card_even_wider text_center">
    <a class="back_link back_link_corner" href="<%= homePath %>">Home</a>
    <header>
      <h1>Scheduled Consultations</h1>
      <p>View your upcoming consultations here.</p>
    </header>
      <section>
        <p id="scheduled_consultations_msg" class="is_hidden" aria-live="polite"></p>
        <% if (consultations.length === 0) { %>
          <p>No upcoming consultations yet.</p>
        <% } else { %>
          <div class="dashboard_consultations">
            <% consultations.forEach(function (consultation) { %>
              <% const roster = Array.isArray(consultation.roster) ? consultation.roster : [] %>
              <article class="profile_detail join_consultation_item">
                <div class="search_flex join_consultation_header">
                  <h2 class="home_navigation_title"><%= consultation.name %></h2>
                </div>
                <div class="register_columns">
                  <div class="register_left_column">
                    <p class="profile_detail_value"><strong>Organiser:</strong> <%= consultation.organiser %></p>
                    <p class="profile_detail_value"><strong>Date:</strong> <%= consultation.date %></p>
                  </div>
                  <div class="register_middle_column">
                    <p class="profile_detail_value"><strong>Time:</strong> <%= consultation.time %></p>
                  </div>
                  <div class="register_right_column text_center">
                    <% if (consultation.id) { %>
                      <button type="button" class="join_button btn_danger" data-cancel-id="<%= consultation.id %>">Cancel</button>
                    <% } %>
                  </div>
                </div>
                <section class="dashboard_roster">
                  <h4 class="dashboard_roster_title">Attendee roster</h4>
                  <% if (roster.length === 0) { %>
                    <p class="dashboard_roster_empty">No confirmed students booked for this session yet.</p>
                  <% } else { %>
                    <ul class="dashboard_roster_list">
                      <% roster.forEach(function (attendee) { %>
                        <li><%= attendee %></li>
                      <% }) %>
                    </ul>
                  <% } %>
                </section>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section>
        <h2>Calendar</h2>
        <h3 class="calendar_title"><%= calendar.monthLabel %></h3>
        <table class="calendar_table">
          <thead>
            <tr>
              <% calendar.dayLabels.forEach(function (dayLabel) { %>
                <th class="calendar_heading" scope="col"><%= dayLabel %></th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <% calendar.weeks.forEach(function (week) { %>
              <tr>
                <% week.forEach(function (day) { %>
                  <% const dayConsultations = consultationsByDate[day.isoDate] || [] %>
                  <% if (day.isEmpty) { %>
                    <td class="calendar_day calendar_day_empty"></td>
                  <% } else { %>
                    <td class="calendar_day<%= dayConsultations.length > 0 ? ' calendar_day_scheduled' : '' %>">
                      <div class="calendar_day_content">
                        <span class="calendar_day_number"><%= day.dayNumber %></span>
                        <% dayConsultations.forEach(function (consultation) { %>
                          <span class="calendar_day_note calendar_day_note_dashboard"><%= consultation.name %> &middot; <%= consultation.time %></span>
                        <% }) %>
                      </div>
                    </td>
                  <% } %>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </section>

  </main>
</body>
</html>