<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles/main.css">
</head>
<body class="page page_home">
  <main class="card card_even_wider text_center">
    <header>
      <h1>Lecturer Dashboard</h1>
      <% if (username) { %>
        <p>Hello <%= username %></p>
      <% } %>
      <p>View your upcoming consultations and calendar in one place.</p>
    </header>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } else { %>
      <section>
        <h2>Upcoming Consultations</h2>
        <% if (consultations.length === 0) { %>
          <p>No upcoming consultations yet.</p>
        <% } else { %>
          <div class="dashboard_consultations">
            <% consultations.forEach(function (consultation) { %>
              <article class="dashboard_consultation_card">
                <h3><%= consultation.name %></h3>
                <p class="dashboard_consultation_meta"><strong>Organiser:</strong> <%= consultation.organiser %></p>
                <p class="dashboard_consultation_meta"><strong>Date:</strong> <%= consultation.date %></p>
                <p class="dashboard_consultation_meta"><strong>Time:</strong> <%= consultation.time %></p>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section>
        <h2>Calendar</h2>
        <p>Your scheduled consultation calendar will appear here.</p>
      </section>
    <% } %>

    <a class="back_link" href="<%= homePath %>">Home</a>
  </main>
</body>
</html>