{
  "scripts": {
    "start": "node src/app.js",
    "check:db": "node src/models/db.js",
    "test": "npm run test:coverage:all",
    "test:unit": "jest",
    "test:e2e": "c8 --config tests/.c8rc.json playwright test",
    "test:integration:web": "jest --config tests/integration/jest.config.js --runInBand",
    "test:integration:web:coverage": "c8 --config tests/.c8rc.json jest --config tests/integration/jest.config.js --runInBand --coverage=false",
    "test:coverage:all:run": "jest --runInBand --coverage=false && jest --config tests/integration/jest.config.js --runInBand --coverage=false && playwright test",
    "test:coverage:all": "c8 --config tests/.c8rc.json npm run test:coverage:all:run",
    "lint": "standard \"src/**/*.js\" \"tests/**/*.js\""
  },
  "jest": {
    "collectCoverage": true,
    "testMatch": [
      "<rootDir>/tests/unit/**/*.test.js"
    ],
    "testTimeout": 30000
  },
  "standard": {
    "globals": [
      "afterAll",
      "afterEach",
      "beforeAll",
      "beforeEach",
      "describe",
      "expect",
      "jest",
      "test"
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "mongodb": "^7.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "c8": "^11.0.0",
    "jest": "^30.3.0",
    "standard": "^17.1.2"
  }
}
